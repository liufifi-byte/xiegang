# GLM-5 (智谱)
GLM_API_KEY=your_zhipu_api_key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5
GLM_EMBEDDING_MODEL=embedding-3
# HTTP 请求总超时（秒）。生产 R3 辩论时 5 议员并发 + 长 transcript 累积，
# 单次 GLM 调用经常 80-150s。旧默认 45s 会频繁 ReadTimeout → 议会失败。
# 180s 留充足余量（必要时可调到 240s）。
GLM_REQUEST_TIMEOUT_SECONDS=180

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key
# Pooler URL（HTTP API + IPv6 fallback）—— Supabase Dashboard 里的 6543 pooler
# 注意：supabase 直连域名（5432 端口）只有 AAAA(IPv6)记录，
# 国内云服务器（如腾讯云轻量）默认无 IPv6 出站，会持续报 Network is unreachable。
# 此时应用会自动 fallback 到这条 pooler URL。所以此处必须填能用 IPv4 的 pooler URL。
SUPABASE_DB_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# 直连 URL（直连 5432 端口，绕过 Supavisor pooler）。
# 留空 → 应用全走 pooler（兼容性最好，但可能踩 prepared statement 问题）。
# 填值 → 应用会探测 host 是否有 IPv4 / 本机是否有 IPv6 出站，自动选择更合适的 URL。
# Dashboard → Project Settings → Database → Connection string → "Direct connection"
SUPABASE_DB_URL_DIRECT=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Tavily (搜索)
WEB_SEARCH_ENGINE=search_std
WEB_SEARCH_TIMEOUT_SECONDS=15

# 应用配置
APP_ENV=development
LOG_LEVEL=INFO

# P0-S1.4 CORS（前端域名，逗号分隔；生产换 https://your.vercel.app）
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# 议会总超时（秒）。完整议会实测需 14-20 分钟，旧 720s 经常砍断。
PARLIAMENT_TOTAL_TIMEOUT=1200

# 单 Agent ReAct 总超时。线上实测 180s 仍砍断 3/5 专家（贴上限） → 写"未完成"文案。
AGENT_TOTAL_TIMEOUT_SECONDS=240

# P0-S1.1 限流（创建议会）
RATE_LIMIT_IP_PER_MINUTE=2
RATE_LIMIT_DEVICE_DAILY=10

# LLM 调用并发（worker 进程内全局上限）
# 单 worker 同时飞的最大 LLM 请求数；多 Worker 部署时总并发 = worker_副本 × 此值。
# 调高前必须确认智谱账户额度，否则会撞 1302（账户并发上限）/ 1305（平台过载）。
LLM_MAX_CONCURRENCY=5

# ============================================================
# 根治方案：进程防呆 + 公平分槽（防"两个 worker / 数据老 / 等待中"问题）
# ============================================================
# L1/L2 调试开关：true 跳过 flock + DB heartbeat 启动闸（仅本机多 worker 调试用）
WORKER_ALLOW_DUPLICATE=false

# L3 orphan 自愈阈值（秒）：超过这个时间无 heartbeat 的 running 议会被标 failed。
# 原 900s（15 分钟）会让卡死议会等太久；默认 120s。
# orphan 自愈阈值（秒）。必须 > 议会总耗时（最长 1200s），故改 600s
# 之前 120s 会误杀正在跑的议会。
PARLIAMENT_STALE_SECONDS=1800

# 每议会公平分槽：单议会内同时飞的最大 LLM 请求数。
# 单议会场景 5 Agent 同时跑；>=2 议会时再调到 2-3 避免互踩
PER_PARLIAMENT_LLM_CONCURRENCY=5
