# GLM-5 (智谱)
GLM_API_KEY=your_zhipu_api_key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5
GLM_EMBEDDING_MODEL=embedding-3

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_DB_URL=postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres

# Tavily (搜索)
WEB_SEARCH_ENGINE=search_std
WEB_SEARCH_TIMEOUT_SECONDS=15

# 应用配置
APP_ENV=development
LOG_LEVEL=INFO

# P0-S1.4 CORS（前端域名，逗号分隔；生产换 https://your.vercel.app）
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# P0-S1.2 议会总超时（秒）
PARLIAMENT_TOTAL_TIMEOUT=480

# P0-S1.1 限流（创建议会）
RATE_LIMIT_IP_PER_MINUTE=2
RATE_LIMIT_DEVICE_DAILY=10
